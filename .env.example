# ── Required ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Zendesk (needed for the /zendesk/webhook auto-fetch transcript path) ───
ZENDESK_SUBDOMAIN=headout
ZENDESK_EMAIL=agent@headout.com
ZENDESK_TOKEN=your-zendesk-api-token

# Zendesk custom field ID for the Minded / interaction tag field
MINDED_TAG_FIELD_ID=360023704091

# ── API security ─────────────────────────────────────────────────────────
# All POST routes check this Bearer token when set. Leave blank for open.
API_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4.1-nano
PORT=3000
